# Copie este arquivo para ".env" e preencha com os dados reais do seu banco.
# NUNCA suba o arquivo ".env" (com senha real) para o Git.

# String de conexão do PostgreSQL.
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
#
# Exemplos por provedor:
#   Supabase:  postgresql://postgres:SENHA@db.xxxxxxxx.supabase.co:5432/postgres
#   Neon:      postgresql://usuario:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
#   Azure DB:  postgresql://usuario@servidor:SENHA@servidor.postgres.database.azure.com:5432/postgres?sslmode=require
#   RDS (AWS): postgresql://usuario:SENHA@meubanco.xxxxx.sa-east-1.rds.amazonaws.com:5432/postgres
DATABASE_URL=postgresql://usuario:senha@host:5432/preparo_exames_dev

# Chave usada pelo Flask para assinar sessões/cookies. Gere uma própria, por
# exemplo com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-gerada-aleatoriamente

# Opcional: chave da API da Anthropic (console.anthropic.com), para o chat
# do paciente responder de forma mais flexível (interpretando o preparo em
# linguagem natural), em vez de só correspondência por palavra-chave. Sem
# essa chave, o chat continua funcionando normalmente, só com a
# correspondência por palavra-chave (ver app/faq_engine.py).
# ANTHROPIC_API_KEY=sk-ant-...
# Opcional: troca o modelo usado (padrão: claude-haiku-4-5, mais barato).
# ANTHROPIC_MODEL=claude-haiku-4-5

# Opcional: chave da API do Google Gemini (aistudio.google.com/apikey), usada
# SÓ para a extração de PDF de preparo (ver app/ia_pdf_preparo.py) - trocado
# da Claude para o Gemini por ser bem mais barato nessa tarefa de leitura de
# documento. Não afeta o chat de dúvidas do paciente (continua na Claude/
# ChatGPT, acima). Sem essa chave, a importação de PDF cai na extração
# heurística por regex (ver app/pdf_preparo.py) - nada quebra.
# GEMINI_API_KEY=...
# Opcional: troca o modelo usado (padrão: gemini-2.5-flash, mais barato).
# GEMINI_MODEL=gemini-2.5-flash

# Fatia 7 (área de WhatsApp, ver PLANO_WHATSAPP.md, app/routes_whatsapp.py
# e app/whatsapp_envio.py) - API direta da Meta (WhatsApp Cloud API), sem
# intermediário (Twilio foi removida, ver PLANO_WHATSAPP.md, seção
# "Migração para Meta Cloud API direta"). Todas as variáveis abaixo vêm de
# um app Meta Business (developers.facebook.com) com o produto WhatsApp
# adicionado, depois de criar/verificar o Meta Business Manager e o
# número de telefone da aplicação - ver checklist completo no plano.
#
# RECEBIMENTO (webhook, app/routes_whatsapp.py):
# String arbitrária escolhida por você, cadastrada IGUAL aqui e no campo
# "Verify token" de WhatsApp Manager > Configuração > Webhooks - usada só
# no handshake inicial (GET) de verificação do webhook.
# WHATSAPP_META_VERIFY_TOKEN=escolha-uma-string-qualquer
# App Secret do app Meta (Configurações básicas do app) - usado para
# validar a assinatura (X-Hub-Signature-256) de cada webhook recebido.
# Sem essa variável, o webhook recusa toda requisição recebida.
# WHATSAPP_META_APP_SECRET=...
#
# ENVIO (respostas automáticas, app/whatsapp_envio.py):
# Token de acesso permanente de um System User da Meta Business
# (WhatsApp Manager > Configuração da API > gerar token), com a
# permissão "whatsapp_business_messaging".
# WHATSAPP_META_ACCESS_TOKEN=...
# ID do número de telefone da aplicação no WhatsApp Cloud API (não é o
# número em si - ver WhatsApp Manager > Números de telefone).
# WHATSAPP_META_PHONE_NUMBER_ID=...
# Opcional: nome do template aprovado usado para responder uma pergunta
# fora da janela de 24h da última mensagem do paciente (ver docstring de
# app/whatsapp_envio.py) - sem essa variável, tenta como texto livre, que
# só funciona DENTRO dessa janela.
# WHATSAPP_META_TEMPLATE_RESPOSTA=resposta_duvida_paciente
# Opcional (padrão "pt_BR"): idioma cadastrado junto com o template acima.
# WHATSAPP_META_TEMPLATE_IDIOMA=pt_BR
# Opcional (padrão "v22.0"): versão da Graph API usada nas chamadas.
# WHATSAPP_META_API_VERSION=v22.0

# Gateway de pagamento real (Fatia 8, licença individual do médico - ver
# app/mercadopago_integration.py). Sem essas variáveis, o botão "Gerar
# cobrança (Mercado Pago)" em /dono/usuarios continua existindo mas falha
# com uma mensagem clara - o controle manual (marcar como pago na mão)
# continua funcionando normalmente sem isso.
# Access Token da conta Mercado Pago (Suas integrações > credenciais) -
# comece pelas credenciais de TESTE até confirmar que cobrança -> webhook
# -> mês marcado como pago funciona de ponta a ponta.
# MERCADOPAGO_ACCESS_TOKEN=...
# Chave secreta gerada em Suas integrações > Webhooks > Configurar
# notificações - usada só para validar a assinatura de cada notificação
# recebida. Sem essa variável, o webhook recusa QUALQUER notificação.
# MERCADOPAGO_WEBHOOK_SECRET=...

# PWA da equipe com notificação push (ver app/push_notificacoes.py e
# gerar_chaves_vapid.py) - avisa o médico/secretária no celular quando
# chega pergunta nova de paciente, sem depender do WhatsApp de volta. Rode
# `python gerar_chaves_vapid.py` uma vez para gerar as 3 variáveis abaixo
# (o par de chaves é o mesmo para sempre - gerar de novo troca a
# identidade do servidor e invalida toda inscrição já feita pela equipe).
# Sem essas 3 variáveis, o recurso fica desligado sozinho (nada quebra).
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_CLAIM_EMAIL=mailto:contato@inflor.com.br
