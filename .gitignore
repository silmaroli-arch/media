venv/
instance/

# Gerado automaticamente pelo pipeline de deploy (.github/workflows/deploy.yml)
# a cada publicação - nunca deve ser commitado manualmente.
deploy_info.json

# Elastic Beanstalk Files
.elasticbeanstalk/*
!.elasticbeanstalk/*.cfg.yml
!.elasticbeanstalk/*.global.yml
tmp_export_debug.tar.gz

# Bilhete de uma linha que o Claude deixa com um resumo da mudanca antes do
# auto_commit_push.bat rodar (ver auto_commit_push.bat) - e sempre apagado
# pelo proprio script antes do commit, mas fica aqui tambem por seguranca
# caso essa etapa falhe por algum motivo.
ultima_mudanca.txt

# Log do auto_commit_push.bat - cresce a CADA execucao do agendador (a cada
# poucos minutos), mesmo quando nao ha nenhuma mudanca de codigo real. Se
# ele ficasse rastreado pelo git (como ficou por engano ate agora), isso
# gerava um commit - e um deploy inteiro no GitHub Actions - a cada
# execucao, so por causa do log crescer. So deve existir localmente.
auto_commit_push.log
